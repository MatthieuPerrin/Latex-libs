\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{distributed}[2025/09/24 Package for drawing distributed computing executions]

\RequirePackage{tikz}
\usetikzlibrary{patterns}
\usetikzlibrary{arrows,shadows}
\usetikzlibrary{calc}
\usetikzlibrary{arrows.meta}
\usetikzlibrary{decorations.markings}
\usetikzlibrary{decorations.pathmorphing}
\usetikzlibrary{decorations.pathreplacing}

\RequirePackage{algorithm2e}

\SetKw{Send}{send}
\SetKw{Receive}{receive}
\SetKwFunction{SBroadcast}{synch-broadcast}
\SetKwFunction{Broadcast}{broadcast}
\SetKwFunction{Deliver}{deliver}

\newcommand{\SetKwMessage}[2]{%
  \expandafter\newcommand\csname #1\endcsname{%
    \textup{\textsc{#2}}%
  }%
}

\newcommand{\SetKwBroadcast}[2]{%
  \expandafter\newcommand\csname #1\endcsname{%
    \textbf{\textup{\textsc{#2}}}%
  }%
}


\pgfkeysifdefined{/tikz/draw highlighted}{}{%
  \tikzset{%
    draw highlighted/.style={},%
  }%
}
\pgfkeysifdefined{/tikz/fill highlighted}{}{%
  \tikzset{%
    fill highlighted/.style={},%
  }%
}


\pgfdeclarepatternformonly{badPattern}{\pgfqpoint{-4pt}{-4pt}}{\pgfqpoint{8pt}{8pt}}{\pgfqpoint{4pt}{4pt}}{
  \pgfsetlinewidth{1.414pt}
  \pgfpathmoveto{\pgfqpoint{0pt}{0pt}}
  \pgfpathlineto{\pgfqpoint{4pt}{4pt}}
  \pgfusepath{stroke}
}

\tikzset{
  bad execution style/.style={
    draw=alert, pattern=badPattern, pattern color=alert!15, rounded corners,
  },
  good execution style/.style={
    draw=structure!40, fill=structure!7, rounded corners,
  },
  bad execution/.style={
    execute at end picture={
      \begin{pgfonlayer}{execution@background}
        \path[bad execution style] (current bounding box.south west) rectangle (current bounding box.north east);
      \end{pgfonlayer}
    }
  },
  good execution/.style={
    execute at end picture={
      \begin{pgfonlayer}{execution@background}
        \path[good execution style] (current bounding box.south west) rectangle (current bounding box.north east);
      \end{pgfonlayer}
    }
  },
}

\tikzset{
  operation/.style={
    draw,
    fill=white,
    draw highlighted,
    fill highlighted,
    rectangle,
    rounded corners,
    anchor=center,
    align=center,
    inner xsep=3mm,
    inner ysep=1mm,
    outer xsep=-1mm,
    outer ysep=10mm,
    minimum height=4mm,
  },
  event/.style={
    draw,
    fill=white,
    draw highlighted,
    fill highlighted,
    circle,
    inner sep=1.5mm,
    outer sep=-1mm,
  },
  message/.style={
    {Circle[length=2.4pt,width=2.4pt]}-{Stealth[length=5pt]},
    shorten <=-1.2pt,
    auto,
  },
  messages/.append style={
    every edge/.append style={
      message,
    },
  },
  message error/.style={
    {Circle[length=2pt,width=2pt]}-{Rays[length=10pt,width=10pt]},
    shorten <=-1.2pt,
    shorten >=-4pt,
    auto,
  },
  lin point/.style={
    {Circle[length=2pt,width=2pt]}-{Circle[length=2pt,width=2pt]},
    shorten <=-1pt,
    shorten >=-1pt,
  },
  every process/.style={
    draw=none,
    to path={
      \pgfextra{
        \begin{pgfonlayer}{process@background}
          \draw (\tikztostart) -- (\tikztotarget);
        \end{pgfonlayer}
        \begin{pgfonlayer}{process@foreground}
          \draw[thin, densely dotted] (\tikztostart) -- (\tikztotarget);
        \end{pgfonlayer}
      }
      (\tikztostart) -- (\tikztotarget)  ([xshift=4pt]\tikztotarget) \tikztonodes
    }
  },
  process/.style={
    Bar-Straight Barb,
    every process,
  },
  crashed/.style={
    Bar-Rays,
    every process,
  },
  replica/.style={
    font=\footnotesize,
    above right,
  },
  replica below/.style={
    replica,
    below right,
  },
  bend below/.style={
    out=-60,
    in=120,
    distance=#1,
  },
  bend above/.style={
    out=60,
    in=-120,
    distance=#1,
  },
  bend above/.default=25,
  bend below/.default=25,
  bend left/.default=25,
  bend right/.default=25,
}

\pgfdeclarelayer{execution@background}
\pgfdeclarelayer{process@background}
\pgfdeclarelayer{process@foreground}
\pgfsetlayers{execution@background, process@background, main, process@foreground}

\endinput
